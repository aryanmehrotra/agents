# local env — may contain API keys (tracked: .env.example, .env.local)
**/configs/.env

# go build output
bin/
*.exe
*.test
*.out

# editor / OS
.DS_Store
.idea/
.vscode/

# compiled binaries (go build . emits one named after the module directory).
# Agents live nested under agents/<category>/<name>-agent/ — match at that depth, not just the root.
/*/*-agent
agents/*/*/*-agent
orchestrator/orchestrator
localtest/*/claude-openai-shim

# a seeded SQLite file, created at runtime (e.g. sql-agent's)
agents/*/*/*.db
