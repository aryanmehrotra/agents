# local env — may contain API keys (tracked: .env.example, .env.local)
**/configs/.env

# go build output
bin/
*.exe
*.test
*.out

# editor / OS
.DS_Store
.idea/
.vscode/

# compiled binaries (go build . emits one named after the module directory, nested under agents/<group>/)
**/*-agent/*-agent
orchestrator/orchestrator
localtest/*/claude-openai-shim

# sql-agent's seeded SQLite file, created at runtime
**/sql-agent/*.db
