# Default (pushed) config — Groq. Copy to configs/.env and add your key.
APP_NAME=orchestrator
HTTP_PORT=8080
METRICS_PORT=2124

LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=your-groq-api-key-here

# front-door API key (callers send  X-Api-Key: <this>)
API_KEY=agents-demo-key

# Specialist targets (defaults to localhost). Override for a real deployment:
# DATA_AGENT_URL=http://data-agent:8000
# SUPPORT_AGENT_URL=http://support-agent:8001
# KB_AGENT_URL=http://kb-agent:8002
