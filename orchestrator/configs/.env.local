# Keyless local testing via the claude-openai-shim. Start it + the specialist agents first.
APP_NAME=orchestrator
HTTP_PORT=8080
METRICS_PORT=2124

LLM_PROVIDER=openai
LLM_MODEL=claude-shim
LLM_API_KEY=local-no-key-needed
LLM_BASE_URL=http://localhost:8088/v1

# front-door API key (callers send  X-Api-Key: agents-demo-key)
API_KEY=agents-demo-key
