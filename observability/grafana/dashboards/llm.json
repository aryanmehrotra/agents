{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "title": "GoFr Agents \u2014 Multi-Agent Observability",
  "uid": "gofr-llm",
  "tags": [
    "gofr",
    "llm",
    "agents"
  ],
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "refresh": "5s",
  "schemaVersion": 39,
  "timezone": "browser",
  "panels": [
    {
      "type": "stat",
      "title": "Inter-agent calls",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8899AA",
                "value": null
              },
              {
                "color": "#FF7A00",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "(sum(app_http_service_response_count{service=~\".*-agent\"})) or vector(0)",
          "refId": "A"
        }
      ],
      "id": 1
    },
    {
      "type": "stat",
      "title": "HTTP requests",
