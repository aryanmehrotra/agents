# Keyless local testing via the claude-openai-shim. Start it (and the orchestrator + specialists) first.
APP_NAME=workflow-agent
HTTP_PORT=8012

LLM_PROVIDER=openai
LLM_MODEL=claude-shim
LLM_API_KEY=local-no-key-needed
LLM_BASE_URL=http://localhost:8088/v1
METRICS_PORT=2134

# The only peer it needs — the orchestrator hub it dispatches every step through.
ORCHESTRATOR_URL=http://localhost:8080
API_KEY=agents-demo-key
