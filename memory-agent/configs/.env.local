# Local, keyless — but memory needs a STATELESS chat model and a REAL embedding model, so this agent
# uses Ollama (not the claude-shim, whose chat carries state and whose embeddings are lexical).
#   ollama serve
#   ollama pull llama3.2:1b && ollama pull nomic-embed-text
#   SurrealDB: docker run --rm -p 8010:8000 surrealdb/surrealdb:latest start --user root --pass root memory
APP_NAME=memory-agent
HTTP_PORT=8006
METRICS_PORT=2128

CHAT_MODEL=llama3.2:1b
EMBED_MODEL=nomic-embed-text

SURREAL_HOST=localhost
SURREAL_PORT=8010
SURREAL_USER=root
SURREAL_PASS=root
SURREAL_NS=agents
SURREAL_DB=memory

# Observability — chat AND embed calls flow through GoFr's LLM instrumentation, so both show up in
# Jaeger (llm.chat / llm.embed spans) and Grafana (app_llm_request_count split by operation).
# Start the stack:  cd ../observability && docker compose up -d
TRACE_EXPORTER=otlp
TRACER_HOST=localhost
TRACER_PORT=4317

# Compaction: memory-agent calls the summarizer-agent to compress old turns once a session grows.
# Optional — chat works without it (compaction is best-effort). Run: ../../summarizer-agent
SUMMARIZER_AGENT_URL=http://localhost:8005
