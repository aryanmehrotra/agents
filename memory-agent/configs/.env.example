# Cloud setup. Memory needs a STATELESS chat model and a REAL (semantic) embeddings model, so the
# provider must serve BOTH chat and /v1/embeddings. OpenAI does; Groq (chat-only) does not.
# For a fully local, keyless setup use configs/.env.local (Ollama) instead — recommended for trying
# this out. See the README.
APP_NAME=memory-agent
HTTP_PORT=8006
METRICS_PORT=2128

# Chat model (stateless) and embeddings model (768-dim+ for real semantic recall).
CHAT_PROVIDER=openai
CHAT_MODEL=gpt-4o-mini
EMBED_PROVIDER=openai
EMBED_MODEL=text-embedding-3-small
OPENAI_API_KEY=your-openai-api-key-here

SURREAL_HOST=localhost
SURREAL_PORT=8010
SURREAL_USER=root
SURREAL_PASS=root
SURREAL_NS=agents
SURREAL_DB=memory

# Observability — chat and embed calls both flow through GoFr's LLM instrumentation.
TRACE_EXPORTER=otlp
TRACER_HOST=localhost
TRACER_PORT=4317

# Compaction: memory-agent calls the summarizer-agent to compress old turns once a session grows.
# Optional — chat works without it (compaction is best-effort). Run: ../../summarizer-agent
SUMMARIZER_AGENT_URL=http://localhost:8005
