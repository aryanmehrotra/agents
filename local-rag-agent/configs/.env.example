# local-rag-agent runs entirely on-device — there is no provider key to set. Copy to configs/.env.
# Both the chat and embedding models run in-process on llama.cpp via Kronk (GGUF, auto-downloaded);
# the only external dependency is a SurrealDB for the vectors:
#   docker run --rm -p 8000:8000 surrealdb/surrealdb:latest start --user root --pass root memory
APP_NAME=local-rag-agent
HTTP_PORT=8010
METRICS_PORT=2132

# Any GGUF Kronk can resolve works. Examples:
#   CHAT_MODEL=unsloth/Qwen3-0.6B-Q8_0.gguf                 # tiny, fast (default)
#   CHAT_MODEL=unsloth/Qwen2.5-3B-Instruct-GGUF             # better answers, more RAM
#   CHAT_MODEL=/abs/path/to/your-model.gguf                 # a local file
CHAT_MODEL=unsloth/Qwen3-0.6B-Q8_0.gguf
EMBED_MODEL=ggml-org/embeddinggemma-300m-qat-Q8_0.gguf
CHAT_MAX_TOKENS=512
ENABLE_THINKING=false
# CHAT_CONTEXT=4096
# RECALL_FLOOR=0.35

SURREAL_HOST=localhost
SURREAL_PORT=8000
SURREAL_USER=root
SURREAL_PASS=root
SURREAL_NS=agents
SURREAL_DB=rag

TRACE_EXPORTER=otlp
TRACER_URL=localhost:4317
