# Fully local — no API key, no hosted provider. Both models run in-process on llama.cpp via Kronk
# and are auto-downloaded (GGUF) on first run. You only need a SurrealDB for the vectors:
#   docker run --rm -p 8000:8000 surrealdb/surrealdb:latest start --user root --pass root memory
APP_NAME=local-rag-agent
HTTP_PORT=8010
METRICS_PORT=2132

# Local models (Kronk resolves these from Hugging Face and caches them). Swap for any GGUF you like —
# see the README "Customising" section (bigger chat model, different embedder, etc.).
CHAT_MODEL=unsloth/Qwen3-0.6B-Q8_0.gguf
EMBED_MODEL=ggml-org/embeddinggemma-300m-qat-Q8_0.gguf
CHAT_MAX_TOKENS=512
ENABLE_THINKING=false
# CHAT_CONTEXT=4096      # override the model's default context window
# RECALL_FLOOR=0.35      # drop retrieved chunks below this cosine similarity (default 0 = keep top-k)

# SurrealDB = the vector database, via GoFr's datasource.
SURREAL_HOST=localhost
SURREAL_PORT=8000
SURREAL_USER=root
SURREAL_PASS=root
SURREAL_NS=agents
SURREAL_DB=rag

# Observability — the local chat model's calls flow through GoFr's LLM instrumentation, so they show
# up in Jaeger (llm.chat spans) and Grafana (app_llm_request_count) like any hosted provider would.
TRACE_EXPORTER=otlp
TRACER_URL=localhost:4317
