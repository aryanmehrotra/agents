APP_NAME=org-memory
HTTP_PORT=8000
METRICS_PORT=2140

# --- Storage (behind the Store interface; pick one, all zero-infra) ---
ORG_MEMORY_DB=./org-memory.db       # embedded SQLite (pure-Go, persistent) — recommended local
# ORG_MEMORY_PATH=./memory.json     # JSON file store
# (unset both = in-memory)

# --- Embeddings (real semantic recall via any OpenAI-compatible /v1/embeddings) ---
EMBED_BASE_URL=http://localhost:11434/v1   # Ollama default; point at your orchestrator/OpenAI
EMBED_MODEL=nomic-embed-text
# EMBED_API_KEY=                            # only if the provider requires it
# ORGMEM_EMBED=local                        # explicit offline mode (deterministic, no provider)

# --- Relevance floor: AUTO-CALIBRATED at startup from the corpus itself (no number to hand-pick).
# On boot, org-memory measures how similar generic OFF-TOPIC probes get to your memory (the "noise
# ceiling") and sets the floor just above it — so it adapts to whatever corpus you load. Re-run any
# time via POST /calibrate. To override with a fixed number instead, uncomment the next line (an
# explicit seed disables auto-calibration); to disable auto-calibration entirely, set AUTOCALIBRATE=off.
# ORGMEM_retrieve__precision_floor=0.60   # fixed override — a starting point, NOT a universal truth
# ORGMEM_AUTOCALIBRATE=off                # disable startup auto-calibration
# ORGMEM_retrieve__calibration_margin=0.03

# --- Forgetting / consolidation (retrievability decays with disuse; NOTHING is deleted — a decayed
# decision is demoted out of hot recall and revives if reinforced). Storage vs retrieval strength,
# Bjork & Bjork 1992. See POST /consolidate for the hot/cold memory-health report.
# ORGMEM_forget__halflife_days=90         # freshness half-life; larger = memories persist longer
# ORGMEM_forget__floor=0.03               # below this retrievability a decision is demoted from recall
# ORGMEM_forget__reinforce_per_use=0.5    # how much helpful/used feedback protects a memory
# ORGMEM_forget__penalty_per_negative=0.5 # how much wrong/not-relevant erodes retrievability
# ORGMEM_rank__w_retention=0.3            # weight of retrievability in ranking (freshness bonus)

# --- Authority / seniority weighting: a decision's author has a ROLE, and higher roles carry more
# weight when relevance is close (provenance/authority weighting; EigenTrust-style, seeded here — not
# self-asserted). role.<login> → role name; authority.<role> → its weight; rank.w_authority scales it.
ORGMEM_role__vikash=cto
ORGMEM_role__aryanmehrotra=ssde
ORGMEM_authority__cto=1.0
ORGMEM_authority__ssde=0.6
ORGMEM_authority__sde2=0.3
ORGMEM_authority__default_role=sde2
# w_authority scales the seniority signal. Tradeoff: higher = a CTO's call can override a more-relevant
# lower-authority match (good for "should we…" decisions); lower = relevance dominates and authority
# only breaks near-ties (good for "how do I…" how-tos). 0.15 favors seniority without burying clearly
# better matches. Live-tunable in Tune / POST /config.
ORGMEM_rank__w_authority=0.15

# --- Trust / admission (closes the red-team HIGH: unauthenticated capture + verbatim injection) ---
# WRITES: with no token set, mutating requests (POST/PUT/PATCH/DELETE) are accepted only from
# loopback — a fresh clone still runs zero-config, but is not writable from off-box. Set a token to
# allow remote writes; once set it is required even on loopback.
# ORGMEM_security__write_token=change-me
#
# The `[src: …]` marker in surfaced guidance is an ATTESTATION — an agent reads it as "this came from
# somewhere real". Anyone who can capture a decision also writes its `source`, so the marker is only
# emitted for provenances the ORG verifies here; everything else renders `[unverified src: …]`.
# An empty list attests nothing (fail-closed). A `*` suffix matches a prefix.
ORGMEM_trust__verified_provenance=acme-docs,gofr-docs,book:*,vikash,aryanmehrotra

# Captured text is sanitised to a single line before it enters an agent's context, so a stored
# decision cannot fabricate message structure (fake SYSTEM turns, tool results). Lengths capped.
# ORGMEM_advise__max_what_runes=400
# ORGMEM_advise__max_why_runes=600
# ORGMEM_advise__max_source_runes=120

# --- Decay (see RESEARCH.md §11). These are HALF-LIVES: at H days, retention is exactly 0.5.
# Two curves decay age-since-touch — the ranking recency prior and the forgetting layer — and they
# were previously different functions disagreeing 3x. They are now one function with two knobs.
# ORGMEM_rank__recency_halflife_days=21    # "is this rule current?"  (ranking prior)
# ORGMEM_forget__halflife_days=90          # "is this still retrievable?" (Bjork retrieval strength)

# --- Other live knobs (Gate #0): seed defaults as ORGMEM_<key> (use __ for a dot); tune via POST /config ---
# How many decisions get PREPENDED to every prompt. This is the token bill: measured, k=3 adds
# ~350-400 tokens to each matching prompt. k=1 cuts that by roughly two thirds.
# TRADEOFF, measured on this corpus: 2 of 3 sampled queries come back `ambiguous` (top1-top2 < 0.03),
# so the result k=1 keeps is often statistically tied with the one it drops. k=1 also silences the
# `ambiguous` signal entirely (it needs two items to compare) and makes position bias maximal in the
# feedback data — you can only ever label the top result, which is the degenerate input for the
# counterfactual learning-to-rank that Phase 1 depends on.
ORGMEM_retrieve__top_k=2
# ORGMEM_feedback__wrong_quarantine_at=2

# --- Cross-encoder re-ranking (fixes negation blindness; see rerank.go + PHASE0-AUDIT.md).
# Runs IN-PROCESS via Kronk (llama.cpp/GGUF, Metal on Apple Silicon) — no daemon, no container, no
# ONNX. Off unless set, because it is a ~635MB model. Reorders only the results that already cleared
# the relevance gate, so abstention behaviour is unchanged.
# ORGMEM_RERANK_MODEL=gpustack/bge-reranker-v2-m3-Q8_0
# ORGMEM_rank__rerank_top_n=20        # how many survivors to re-score (cross-encoder is O(n) calls)
# ORGMEM_rank__rerank_budget_ms=2000  # give up and keep the dense ordering rather than stall a prompt

# --- Polarity + entity guards: refuse to answer a question with its own opposite, or with a decision
# about a DIFFERENT subject. Both fixed measured failures nothing else could: dense retrieval, a BM25
# hybrid and a cross-encoder all returned "Fail open" for "should we fail closed", at maximum
# confidence. Silence is a correct answer here; a confident inversion is not. See polarity.go.
# ORGMEM_rank__polarity_guard=1              # 0 disables
# ORGMEM_rank__entity_guard=1                # 0 disables
# ORGMEM_rank__polarity_pairs=open|closed,enable|disable,...   # your domain's opposites
# ORGMEM_rank__negation_cues=not,no,never,without,avoid,...
# ORGMEM_rank__entity_facets=table:,service:,entity:           # facets that name a SUBJECT
