# Default (pushed) config — Groq. Copy to configs/.env and add your key.
# Free key: https://console.groq.com/keys   (swap provider: see data-agent/configs/.env.example)
APP_NAME=kb-agent
HTTP_PORT=8002

LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=your-groq-api-key-here
METRICS_PORT=2123
