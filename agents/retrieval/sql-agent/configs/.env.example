# Default (pushed) config — Groq. Copy to configs/.env and add your key.
# Free key: https://console.groq.com/keys   (swap provider: see data-agent/configs/.env.example)
APP_NAME=sql-agent
HTTP_PORT=8007

LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=your-groq-api-key-here
METRICS_PORT=2129

# Zero-config datasource — GoFr wires up c.SQL straight from these, no AddSQL call needed. SQLite
# needs no host/server; swap to mysql/postgres (+ DB_HOST/DB_USER/DB_PASSWORD) for a real warehouse.
DB_DIALECT=sqlite
DB_NAME=sqlagent
