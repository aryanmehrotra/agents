# Keyless local testing via the claude-openai-shim. Start it first:
#   cd ../../../localtest/claude-openai-shim && go run .
APP_NAME=sql-agent
HTTP_PORT=8007

LLM_PROVIDER=openai
LLM_MODEL=claude-shim
LLM_API_KEY=local-no-key-needed
LLM_BASE_URL=http://localhost:8088/v1
METRICS_PORT=2129

# Zero-config datasource — GoFr wires up c.SQL straight from these, no AddSQL call needed. SQLite
# needs no host/server; swap to mysql/postgres (+ DB_HOST/DB_USER/DB_PASSWORD) for a real warehouse.
DB_DIALECT=sqlite
DB_NAME=sqlagent
