# Default (pushed) config — Groq. Copy to configs/.env and add your key:
#   cp configs/.env.example configs/.env   &&   $EDITOR configs/.env
# Get a free key at https://console.groq.com/keys
#
# Swap providers by changing LLM_PROVIDER + LLM_MODEL + the key:
#   openai   → LLM_MODEL=gpt-4o-mini,               OPENAI_API_KEY=...
#   ollama   → LLM_MODEL=llama3.1,  LLM_BASE_URL=http://localhost:11434/v1  (no key)
#   any OpenAI-compatible endpoint → set LLM_BASE_URL
APP_NAME=data-agent
HTTP_PORT=8000
MCP_PORT=8200

LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=your-groq-api-key-here
METRICS_PORT=2121
