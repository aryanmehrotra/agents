# Default (pushed) config — Groq. Copy to configs/.env and add your key.
APP_NAME=workflow-agent
HTTP_PORT=8012

LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=your-groq-api-key-here
METRICS_PORT=2134

# The orchestrator hub every workflow step is dispatched through, and its front-door API key.
ORCHESTRATOR_URL=http://localhost:8080
API_KEY=agents-demo-key
