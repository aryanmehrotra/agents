# Keyless local testing — routes LLM calls to the claude-openai-shim (no API key, no model install).
# Start the shim first:  cd ../localtest/claude-openai-shim && go run .
APP_NAME=data-agent
HTTP_PORT=8000
MCP_PORT=8200

LLM_PROVIDER=openai
LLM_MODEL=claude-shim
LLM_API_KEY=local-no-key-needed
LLM_BASE_URL=http://localhost:8088/v1
METRICS_PORT=2121
